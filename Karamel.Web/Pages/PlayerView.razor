@page "/player"
@using Fluxor
@using Fluxor.Blazor.Web.Components
@using Karamel.Web.Models
@using Karamel.Web.Contracts
@using Karamel.Web.Helpers
@using Karamel.Web.Store.Playlist
@using Karamel.Web.Store.Session
@using Karamel.Web.Store.Library
@using Microsoft.JSInterop

@inherits FluxorComponent
@implements IAsyncDisposable

@inject IState<SessionState> SessionState
@inject IState<PlaylistState> PlaylistState
@inject IState<LibraryState> LibraryState
@inject IDispatcher Dispatcher
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject System.Net.Http.HttpClient Http
@inject Karamel.Web.Services.ISessionService SessionService

<PageTitle>Karaoke Player</PageTitle>

<div class="player-view">
    @* Admin gear icon (nearly invisible, higher z-index) *@
    @if (isSessionValid)
    {
        <div class="admin-gear-button" @onclick="ToggleAdminMenu" @onclick:stopPropagation="true">
            ⚙️
        </div>

        @if (_showAdminMenu)
        {
            <div class="admin-dropdown" @onclick:stopPropagation="true">
                <div class="admin-dropdown-item open-playlist" @onclick="OpenPlaylistManager">
                    📋 Open Playlist Manager
                </div>
                <div class="admin-dropdown-item open-singer" @onclick="OpenSingerView">
                    🎤 Open Singer View
                </div>
            </div>
        }
    }

    @if (!isSessionValid)
    {
        <div class="alert alert-danger m-4" role="alert">
            <h4 class="alert-heading">Invalid Session</h4>
            <p>No active karaoke session found. Please start a new session from the home page.</p>
        </div>
    }
    else if (PlaylistState.Value.CurrentSong == null)
    {
        <div class="alert alert-warning m-4" role="alert">
            <h4 class="alert-heading">No Song Selected</h4>
            <p>No song is currently playing. Please select a song from the playlist.</p>
        </div>
    }
    else
    {
        <!-- Full-screen canvas for CDG display -->
        <canvas id="cdgCanvas" width="300" height="216" class="cdg-canvas"></canvas>
        
        <!-- Hidden audio element -->
        <audio id="audioPlayer" style="display: none;"></audio>
        
        <!-- Controls overlay (visible on hover) -->
        <div class="controls-overlay" @onmouseenter="ShowControls" @onmouseleave="HideControls">
            @if (showControls)
            {
                <div class="controls">
                    <button class="btn btn-control" @onclick="TogglePlayPause">
                        <i class="bi @(isPlaying ? "bi-pause-circle" : "bi-play-circle")"></i>
                    </button>
                    <button class="btn btn-control" @onclick="StopPlayback">
                        <i class="bi bi-stop-circle"></i>
                    </button>
                    <button class="btn btn-control" @onclick="ToggleFullscreen">
                        <i class="bi @(isFullscreen ? "bi-fullscreen-exit" : "bi-fullscreen")"></i>
                    </button>
                </div>
            }
        </div>
        
        <!-- Left-edge hover detector -->
        <div class="left-edge-detector" @onmouseenter="OnLeftEdgeHover" @onmouseleave="OnLeftEdgeLeave">
            @if (showExpandIcon)
            {
                <div class="expand-icon" @onclick="ToggleSidePanel">
                    <i class="bi bi-chevron-right"></i>
                </div>
            }
        </div>
        
        <!-- Side panel -->
        @if (sidePanelOpen)
        {
            <div class="side-panel">
                <div class="side-panel-header">
                    <button class="btn btn-sm @(sidePanelView == "singer" ? "k-btn-primary" : "k-btn-outline")" 
                            @onclick="@(() => SetSidePanelView("singer"))">
                        Singer
                    </button>
                    <button class="btn btn-sm @(sidePanelView == "playlist" ? "k-btn-primary" : "k-btn-outline")" 
                            @onclick="@(() => SetSidePanelView("playlist"))">
                        Playlist
                    </button>
                    <button class="btn btn-sm btn-close" @onclick="CloseSidePanel">×</button>
                </div>
                <div class="side-panel-content">
                    <iframe src="@GetSidePanelUrl()" frameborder="0"></iframe>
                </div>
            </div>
        }
        
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger error-overlay" role="alert">
                @errorMessage
            </div>
        }
    }
</div>

<ErrorDialog Title="Playback Error" Message="@blockingErrorMessage" Visible="@showBlockingError" OnAccept="OnBlockingErrorAccepted" />

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "session")]
    public string? SessionParam { get; set; }

    private Song? GetCurrentSong()
    {
        return PlaylistHelpers.GetSongById(LibraryState.Value, PlaylistState.Value.CurrentSong?.SongId);
    }

    [Parameter]
    [SupplyParameterFromQuery(Name = "token")]
    public string? TokenParam { get; set; }

    private IJSObjectReference? fileAccessModule;
    private IJSObjectReference? byteStoreModule;
    private IJSObjectReference? playerModule;
    private IJSObjectReference? fullscreenModule;
    private DotNetObjectReference<PlayerView>? dotNetRef;
    
    private bool showControls = false;
    private bool isPlaying = false;
    private bool isFullscreen = false;
    private bool showExpandIcon = false;
    private bool sidePanelOpen = false;
    private string sidePanelView = "singer";
    private string? errorMessage;
    private bool isInitialized = false;
    private bool isSessionValid = false;
    private bool showBlockingError = false;
    private string blockingErrorMessage = string.Empty;
    private Timer? heartbeatTimer;
    private bool _showAdminMenu = false;
    private IJSObjectReference? _protectionModule;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        isSessionValid = ValidateSession();
    }

    private bool ValidateSession()
    {
        // If no session in state, it's invalid
        if (SessionState.Value.CurrentSession == null)
        {
            return false;
        }

        // STRICT VALIDATION: Session parameter is REQUIRED for multi-session support
        if (string.IsNullOrWhiteSpace(SessionParam) || !Guid.TryParse(SessionParam, out var sessionGuid))
        {
            return false;
        }

        // Session ID must match the parameter
        return SessionState.Value.CurrentSession.SessionId == sessionGuid;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                // Import JavaScript modules
                fileAccessModule = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/fileAccess.js");
                byteStoreModule = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/byteStore.js");
                playerModule = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/player.js");
                fullscreenModule = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/fullscreen.js");
                
                // Create .NET reference for callbacks
                dotNetRef = DotNetObjectReference.Create(this);
                
                // Initialize fullscreen module with callback
                await fullscreenModule.InvokeVoidAsync("initializeFullscreen", dotNetRef);
                
                // Check current fullscreen state
                isFullscreen = await fullscreenModule.InvokeAsync<bool>("isFullscreen");
                
                // Check if session and current song exist
                if (SessionState.Value.CurrentSession != null && PlaylistState.Value.CurrentSong != null)
                {
                    // Validate song is marked as NowPlaying before attempting playback
                    if (PlaylistState.Value.CurrentSong.Status != 2) // 2 = NowPlaying
                    {
                        Console.WriteLine($"PlayerView: WARNING - CurrentSong status is {PlaylistState.Value.CurrentSong.Status}, expected 2 (NowPlaying). Correcting status...");
                        Dispatcher.Dispatch(new SetSongStatusAction(PlaylistState.Value.CurrentSong.Id, 2));
                        // Don't wait - status correction will trigger state update and re-render
                    }
                    else
                    {
                        await LoadAndPlaySong();
                    }
                }
                
                // If this is the main tab, add beforeunload warning
                if (SessionService.IsMainTab)
                {
                    try
                    {
                        _protectionModule = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/sessionProtection.js");
                        await _protectionModule.InvokeVoidAsync("setMainTabProtection", 
                            "⚠️ Closing this tab will end the karaoke session for all participants. Are you sure?");
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine($"Failed to load session protection: {ex.Message}");
                    }
                }
                
                isInitialized = true;
            }
            catch (Exception ex)
            {
                errorMessage = MapExceptionToUserMessage(ex, initializing: true);
                StateHasChanged();
            }
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        // If a new song is loaded and we're initialized, play it
        if (isInitialized && PlaylistState.Value.CurrentSong != null && fileAccessModule != null && byteStoreModule != null)
        {
            await LoadAndPlaySong();
        }
    }

    private async Task LoadAndPlaySong()
    {
        if (!ValidatePlaybackPreconditions())
        {
            return;
        }

        var song = GetCurrentSong();
        if (!ValidateRequiredModules(song))
        {
            return;
        }

        errorMessage = null;

        try
        {
            await PrepareByteStoreForNewSong();
            await LoadSongFilesFromDirectory(song!);
            await InitializePlayerForPlayback();
            StartPlayback();
        }
        catch (JSException jsEx)
        {
            HandleBlockingPlaybackError(jsEx);
        }
        catch (Exception ex)
        {
            HandleNonBlockingPlaybackError(ex);
        }
    }

    private bool ValidatePlaybackPreconditions()
    {
        if (SessionService.IsMainTab)
        {
            return true;
        }

        blockingErrorMessage = "⚠️ Playback requires the main tab with library access. Please use the main tab to play songs.";
        showBlockingError = true;
        StateHasChanged();
        return false;
    }

    private bool ValidateRequiredModules(Song? song)
    {
        return song != null
            && fileAccessModule != null
            && byteStoreModule != null
            && playerModule != null;
    }

    private async Task PrepareByteStoreForNewSong()
    {
        // CRITICAL: Clear byteStore cache before loading new files to prevent race condition
        // where initializePlayerWithCallback reads stale MP3 data from previous song
        await byteStoreModule!.InvokeVoidAsync("clearByteStore");
    }

    private async Task LoadSongFilesFromDirectory(Song song)
    {
        var dirPath = song.Path ?? string.Empty;
        var mp3FileName = System.IO.Path.GetFileName(song.Mp3FileName);
        var cdgFileName = System.IO.Path.GetFileName(song.CdgFileName);

        if (SongIsFromZipFile(song))
        {
            var zipInfo = CreateZipInfo(song);
            await fileAccessModule!.InvokeVoidAsync("loadSongFiles", dirPath, mp3FileName, cdgFileName, zipInfo);
        }
        else
        {
            await fileAccessModule!.InvokeVoidAsync("loadSongFiles", dirPath, mp3FileName, cdgFileName);
        }
    }

    private static bool SongIsFromZipFile(Song song)
    {
        return !string.IsNullOrEmpty(song.ZipFileName);
    }

    private static object CreateZipInfo(Song song)
    {
        return new
        {
            zipFileName = song.ZipFileName,
            zipEntryMp3Path = song.ZipEntryMp3Path,
            zipEntryCdgPath = song.ZipEntryCdgPath,
            zipFilePath = song.ZipFilePath
        };
    }

    private async Task InitializePlayerForPlayback()
    {
        await playerModule!.InvokeVoidAsync("initializePlayerWithCallback", dotNetRef);
    }

    private void StartPlayback()
    {
        isPlaying = true;
        StateHasChanged();
    }

    private void HandleBlockingPlaybackError(JSException jsEx)
    {
        blockingErrorMessage = MapExceptionToUserMessage(jsEx, initializing: false);
        showBlockingError = true;
        StateHasChanged();
    }

    private void HandleNonBlockingPlaybackError(Exception ex)
    {
        errorMessage = MapExceptionToUserMessage(ex, initializing: false);
        StateHasChanged();
    }

    private async Task OnBlockingErrorAccepted()
    {
        // Acknowledgement from user - clear blocking state and navigate back to NextSongView
        showBlockingError = false;
        blockingErrorMessage = string.Empty;

        // Complete current song so it's marked as done
        try
        {
            Dispatcher.Dispatch(new CompleteCurrentSongAction());
        }
        catch { }

        var sessionId = SessionState.Value.CurrentSession?.SessionId;
        if (sessionId.HasValue)
        {
            NavigationManager.NavigateTo($"/nextsong?session={sessionId}");
        }

        await Task.CompletedTask;
    }

    [JSInvokable]
    public async Task OnSongEnded()
    {
        try
        {
            // Complete current song via SignalR (marks as Completed, doesn't advance)
            Dispatcher.Dispatch(new CompleteCurrentSongAction());

            // Wait a moment for state to update
            await Task.Delay(250);

            // Navigate back to NextSongView
            var sessionId = SessionState.Value.CurrentSession?.SessionId;
            if (sessionId.HasValue)
            {
                NavigationManager.NavigateTo($"/nextsong?session={sessionId}");
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error handling song end: {ex.Message}";
            StateHasChanged();
        }
    }

    private async Task TogglePlayPause()
    {
        try
        {
            if (playerModule == null) return;

            if (isPlaying)
            {
                await playerModule.InvokeVoidAsync("pausePlayback");
                isPlaying = false;
                // Start sending heartbeats while paused so session does not expire
                await SendHeartbeatAsync();
                StartHeartbeatTimer();
            }
            else
            {
                await playerModule.InvokeVoidAsync("resumePlayback");
                isPlaying = true;
                // Stop heartbeat when resuming playback
                heartbeatTimer?.Dispose();
            }
            
            StateHasChanged();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error toggling playback: {ex.Message}";
            StateHasChanged();
        }
    }

    private async Task SendHeartbeatAsync()
    {
        try
        {
            var session = SessionState.Value.CurrentSession;
            if (session == null) return;
            var url = $"/api/sessions/{session.SessionId}/heartbeat";
            var req = new { ExtendMinutes = 30 };
            var res = await Http.PostAsJsonAsync(url, req);
            if (!res.IsSuccessStatusCode)
            {
                Console.WriteLine($"PlayerView: Heartbeat failed with {(int)res.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"PlayerView: Heartbeat error: {ex.Message}");
        }
    }

    private void StartHeartbeatTimer()
    {
        heartbeatTimer?.Dispose();
        // send heartbeat every 2 minutes while paused
        heartbeatTimer = new Timer(async _ =>
        {
            await SendHeartbeatAsync();
        }, null, TimeSpan.FromMinutes(2), TimeSpan.FromMinutes(2));
    }

    private async Task StopPlayback()
    {
        try
        {
            if (playerModule == null) return;

            await playerModule.InvokeVoidAsync("stopPlayback");
            isPlaying = false;
            
            // Navigate back to NextSongView
            var sessionId = SessionState.Value.CurrentSession?.SessionId;
            if (sessionId.HasValue)
            {
                NavigationManager.NavigateTo($"/nextsong?session={sessionId}");
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error stopping playback: {ex.Message}";
            StateHasChanged();
        }
    }

    private void ShowControls()
    {
        showControls = true;
        StateHasChanged();
    }

    private void HideControls()
    {
        showControls = false;
        StateHasChanged();
    }

    private async Task ToggleFullscreen()
    {
        try
        {
            if (fullscreenModule != null)
            {
                await fullscreenModule.InvokeVoidAsync("toggleFullscreen");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error toggling fullscreen: {ex.Message}");
        }
    }

    [JSInvokable]
    public Task OnFullscreenChanged(bool isNowFullscreen)
    {
        isFullscreen = isNowFullscreen;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private void OnLeftEdgeHover()
    {
        showExpandIcon = true;
        StateHasChanged();
    }

    private void OnLeftEdgeLeave()
    {
        showExpandIcon = false;
        StateHasChanged();
    }

    private void ToggleSidePanel()
    {
        sidePanelOpen = !sidePanelOpen;
        StateHasChanged();
    }

    private void CloseSidePanel()
    {
        sidePanelOpen = false;
        StateHasChanged();
    }

    private void SetSidePanelView(string view)
    {
        sidePanelView = view;
        StateHasChanged();
    }

    private string GetSidePanelUrl()
    {
        var sessionId = SessionState.Value.CurrentSession?.SessionId;
        if (!sessionId.HasValue) return "";

        return sidePanelView switch
        {
            "singer" => $"/singer?session={sessionId}",
            "playlist" => $"/playlist?session={sessionId}",
            _ => ""
        };
    }

    private string MapExceptionToUserMessage(Exception ex, bool initializing)
    {
        var msg = ex is JSException jsEx ? (jsEx.Message ?? "") : (ex.Message ?? "");

        if (initializing)
        {
            if (msg.Contains("File System Access API not available"))
            {
                return "Browser does not support required File System Access API. Please use Chrome or Edge.";
            }
            return $"Failed to initialize player: {msg}";
        }

        // loading errors
        if (msg.Contains("missing_cdg"))
        {
            return "Missing or corrupt CDG file. Please ensure the .cdg file exists and is valid.";
        }

        if (msg.Contains("corrupt_cdg") || msg.Contains("Unable to cast object"))
        {
            return "Missing or corrupt CDG file. Please ensure the .cdg file exists and is valid.";
        }

        return $"Error loading song: {msg}";
    }

    private void ToggleAdminMenu()
    {
        _showAdminMenu = !_showAdminMenu;
    }

    private async Task OpenPlaylistManager()
    {
        var url = $"/playlist?session={SessionParam}&token={TokenParam}";
        try
        {
            await JSRuntime.InvokeAsync<bool>("open", url, "_blank");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error opening Playlist Manager: {ex.Message}");
        }
        _showAdminMenu = false;
    }

    private async Task OpenSingerView()
    {
        var url = $"/singer?session={SessionParam}&token={TokenParam}";
        try
        {
            await JSRuntime.InvokeAsync<bool>("open", url, "_blank");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error opening Singer View: {ex.Message}");
        }
        _showAdminMenu = false;
    }

    protected override async ValueTask DisposeAsyncCore(bool disposing)
    {
        if (disposing)
        {
            if (playerModule != null)
            {
                try
                {
                    await playerModule.InvokeVoidAsync("dispose");
                }
                catch { }
                await playerModule.DisposeAsync();
            }
            
            if (byteStoreModule != null)
            {
                await byteStoreModule.DisposeAsync();
            }
            
            if (fileAccessModule != null)
            {
                await fileAccessModule.DisposeAsync();
            }

            if (_protectionModule != null)
            {
                try
                {
                    await _protectionModule.InvokeVoidAsync("removeMainTabProtection");
                    await _protectionModule.DisposeAsync();
                }
                catch
                {
                    // Ignore disposal errors
                }
            }
            
            if (fullscreenModule != null)
            {
                try
                {
                    await fullscreenModule.InvokeVoidAsync("dispose");
                    await fullscreenModule.DisposeAsync();
                }
                catch
                {
                    // Ignore disposal errors
                }
            }
            
            dotNetRef?.Dispose();
        }
        
        // Call base to dispose Fluxor subscriptions
        await base.DisposeAsyncCore(disposing);
    }
}
