@page "/nextsong"
@using Fluxor
@using Fluxor.Blazor.Web.Components
@using Karamel.Web.Models
@using Karamel.Web.Contracts
@using Karamel.Web.Store.Playlist
@using Karamel.Web.Store.Session
@using Karamel.Web.Store.Library
@using Microsoft.JSInterop
@using Karamel.Web.Services

@inherits FluxorComponent
@implements IAsyncDisposable

@inject IState<SessionState> SessionState
@inject IState<PlaylistState> PlaylistState
@inject IState<LibraryState> LibraryState
@inject IDispatcher Dispatcher
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject IServiceProvider ServiceProvider
@inject System.Net.Http.HttpClient Http

<PageTitle>Next Song - Karamel Karaoke</PageTitle>

<div class="nextsong-view">
    @* Admin gear icon (persistent, subtle) *@
    @if (isSessionValid)
    {
        <div class="admin-gear-button" @onclick="ToggleAdminMenu" @onclick:stopPropagation="true">
            ⚙️
        </div>

        @if (_showAdminMenu)
        {
            <div class="admin-dropdown" @onclick:stopPropagation="true">
                <div class="admin-dropdown-item open-playlist" @onclick="OpenPlaylistManager">
                    📋 Open Playlist Manager
                </div>
                <div class="admin-dropdown-item open-singer" @onclick="OpenSingerView">
                    🎤 Open Singer View
                </div>
            </div>
        }
    }

    @if (!isSessionValid)
    {
        <div class="alert alert-danger m-4" role="alert">
            <h4 class="alert-heading">Invalid Session</h4>
            <p>No active karaoke session found. Please start a new session from the home page.</p>
        </div>
    }
    else
    {
        @if (nextSong != null)
        {
            <div class="nextsong-container">
                <div class="nextsong-content">
                    <h1 class="artist-name">@nextSong?.Artist</h1>
                    <h2 class="song-title">@nextSong?.Title</h2>
                    @if (!string.IsNullOrWhiteSpace(nextSong?.SingerName))
                    {
                        <p class="singer-name">Requested by: @nextSong.SingerName</p>
                    }
                </div>

                @if (isTimerActive && remainingSeconds > 0)
                {
                    <div class="countdown-progress">
                        <div class="progress-bar" style="width: @(progressPercentage)%"></div>
                        <span class="countdown-text">@Math.Ceiling(remainingSeconds) s</span>
                    </div>
                }

                <!-- Lower-left area for microphone icon + QR code when there is a next song -->
                <div class="qrcode-area qrcode-section">
                    <div class="qrcode-content">
                        <div class="microphone-icon small">
                            <img src="/Karamel-icon.jpeg" alt="Karamel" class="karamel-icon" />
                        </div>
                        <p class="qrcode-label">Sing a song</p>
                        @if (isLocalhost)
                        {
                            <a href="@GenerateSessionUrl()" target="_blank" class="session-link">
                                Open Singer View
                            </a>
                        }
                        else
                        {
                            <div id="qrcode-container" class="qrcode-small"></div>
                        }
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="empty-queue-container">
                <div class="empty-queue-content">
                    <div class="microphone-icon">
                        <img src="/Karamel-icon.jpeg" alt="Karamel" class="karamel-icon" />
                    </div>
                    <h1 class="empty-queue-title">Sing a song!</h1>
                    @if (isLocalhost)
                    {
                        <p class="empty-queue-subtitle">Click the link below to add songs to the queue</p>
                        <div class="qrcode-large">
                            <a href="@GenerateSessionUrl()" target="_blank" class="session-link-large">
                                Open Singer View
                            </a>
                        </div>
                    }
                    else
                    {
                        <p class="empty-queue-subtitle">Scan the QR code to add songs to the queue</p>
                        <div id="qrcode-container" class="qrcode-large"></div>
                    }
                </div>
            </div>
        }
    }
</div>

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "session")]
    public string? SessionParam { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "token")]
    public string? TokenParam { get; set; }

    private IJSObjectReference? qrcodeModule;
    private PlaylistItemDto? nextSong;
    private Timer? autoAdvanceTimer;
    private Timer? heartbeatTimer;
    private Timer? countdownTimer;
    private bool isDisposed = false;
    private List<PlaylistItemDto>? previousItems;
    private bool isSessionValid = false;
    private bool isLocalhost = false;
    private bool _showAdminMenu = false;
    private IJSObjectReference? _protectionModule;
    private double remainingSeconds;
    private bool isTimerActive;
    private int totalSeconds;
    private DateTime countdownStart;
    private TaskCompletionSource<bool>? _playlistUpdateAwaiter;
    private string? _currentNextSongId; // Track current next song to prevent timer resets

    // Progress bar shows REMAINING time (empties from right to left as countdown proceeds)
    private double progressPercentage => totalSeconds > 0 ? (remainingSeconds / totalSeconds) * 100 : 0;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        // Check if running on localhost
        isLocalhost = IsLocalhostEnvironment();

        // Validate session parameter
        isSessionValid = ValidateSession();

        // Subscribe to playlist updates so we react immediately when queue changes
        Console.WriteLine($"NextSongView: Subscribing to PlaylistState changes. Current items count={PlaylistState.Value.Items?.Count ?? 0}");
        PlaylistState.StateChanged += OnPlaylistStateChanged;

        // Subscribe to session state changes so we can initialize when session data arrives
        SessionState.StateChanged += OnSessionStateChanged;

        if (isSessionValid)
        {
            // Initialize next song
            UpdateNextSong();
            // Start heartbeat immediately for NextSongView presence
            await SendHeartbeatAsync();
            StartHeartbeatTimer();
            
            // Enable main tab protection if this is the main tab
            var sessionService = ServiceProvider.GetService<ISessionService>();
            if (sessionService?.IsMainTab == true)
            {
                try
                {
                    _protectionModule = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/sessionProtection.js");
                    await _protectionModule.InvokeVoidAsync("setMainTabProtection", 
                        "⚠️ Closing this tab will end the karaoke session for all participants. Are you sure?");
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Failed to load session protection: {ex.Message}");
                }
            }
        }
    }

    private async void OnSessionStateChanged(object? sender, EventArgs e)
    {
        try
        {
            if (!isSessionValid && ValidateSession())
            {
                isSessionValid = true;
                // If session becomes valid later, initialize main-tab responsibilities
                await InitializeMainTabAsync();
                UpdateNextSong();
                StartAutoAdvanceTimer();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"NextSongView: Error handling session state change: {ex.Message}");
        }
    }

    private void OnPlaylistStateChanged(object? sender, EventArgs e)
    {
        try
        {
            var itemsCount = PlaylistState.Value.Items?.Count ?? 0;
            var queuedCount = PlaylistState.Value.Items?.Count(i => i.Status == 0) ?? 0;
            var upNextCount = PlaylistState.Value.Items?.Count(i => i.Status == 1) ?? 0;
            var nowPlayingCount = PlaylistState.Value.Items?.Count(i => i.Status == 2) ?? 0;
            
            Console.WriteLine($"NextSongView: OnPlaylistStateChanged - Total: {itemsCount}, Queued: {queuedCount}, UpNext: {upNextCount}, NowPlaying: {nowPlayingCount}, CurrentSong={(PlaylistState.Value.CurrentSong != null ? $"set (ID: {PlaylistState.Value.CurrentSong.Id})" : "null")}");
            
            // If we're waiting for a playlist update and CurrentSong is now set, complete the awaiter
            if (_playlistUpdateAwaiter != null && PlaylistState.Value.CurrentSong != null)
            {
                Console.WriteLine($"NextSongView: CurrentSong is set to {PlaylistState.Value.CurrentSong.Id}, completing playlist update awaiter");
                _playlistUpdateAwaiter.TrySetResult(true);
                _playlistUpdateAwaiter = null;
            }
            
            UpdateNextSong();
            StartAutoAdvanceTimer();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"NextSongView: Error handling playlist state change: {ex.Message}");
        }

        InvokeAsync(StateHasChanged);
    }

    private bool IsLocalhostEnvironment()
    {
        var uri = new Uri(NavigationManager.Uri);
        var host = uri.Host.ToLowerInvariant();
        return host == "localhost" || host == "127.0.0.1" || host == "::1";
    }

    private bool ValidateSession()
    {
        // If no session in state, it's invalid
        if (SessionState.Value.CurrentSession == null)
        {
            return false;
        }

        // STRICT VALIDATION: Session parameter is REQUIRED for multi-session support
        if (string.IsNullOrWhiteSpace(SessionParam) || !Guid.TryParse(SessionParam, out var sessionGuid))
        {
            return false;
        }

        // Session ID must match the parameter
        return SessionState.Value.CurrentSession.SessionId == sessionGuid;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        Console.WriteLine($"NextSongView: OnAfterRenderAsync firstRender={firstRender}. isSessionValid={isSessionValid}. ItemsCount={PlaylistState.Value.Items?.Count ?? 0}");

        if (isSessionValid && !isLocalhost)
        {
            await GenerateQRCodeAsync();
        }
        
        if (firstRender && isSessionValid && !isLocalhost)
        {
            await InitializeMainTabAsync();
        }
        else if (firstRender && isSessionValid && isLocalhost)
        {
            await InitializeMainTabAsync();
        }
        else if (!firstRender && isSessionValid)
        {
            // Check if playlist changed
            var currentItems = PlaylistState.Value.Items.Where(i => i.Status == 0).ToList();
            if (previousItems == null || !ItemsEqual(previousItems, currentItems))
            {
                // Update next song when playlist changes
                var previousNextSong = nextSong;
                UpdateNextSong();

                    Console.WriteLine($"NextSongView: Playlist changed in OnAfterRender. previousNextId={previousNextSong?.Id} newNextId={nextSong?.Id}");

                // Restart timer if song changed
                if (previousNextSong?.Id != nextSong?.Id)
                {
                    StartAutoAdvanceTimer();
                }

                previousItems = currentItems;
            }
        }
    }

    private async Task GenerateQRCodeAsync()
    {
        try
        {
            // Ensure qrcodeModule is loaded
            if (qrcodeModule == null)
            {
                qrcodeModule = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/qrcode.js");
            }
            var sessionUrl = GenerateSessionUrl();
            await qrcodeModule.InvokeVoidAsync("generateQRCode", "qrcode-container", sessionUrl);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"NextSongView: Failed to generate QR code: {ex.Message}");
        }
    }

    private async Task InitializeMainTabAsync()
    {
        try
        {
            var sessionId = SessionState.Value.CurrentSession?.SessionId;
            var sessionService = ServiceProvider.GetService(typeof(Karamel.Web.Services.ISessionService)) as Karamel.Web.Services.ISessionService;
            if (sessionId != null && sessionService != null)
            {
                await sessionService.InitializeAsync(sessionId.Value, true);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"NextSongView: Failed to initialize SessionService as main tab: {ex.Message}");
        }

        // Start timer if appropriate
        StartAutoAdvanceTimer();
        // Ensure heartbeat timer is running while NextSongView is shown
        StartHeartbeatTimer();
    }

    private async Task SendHeartbeatAsync()
    {
        try
        {
            var session = SessionState.Value.CurrentSession;
            if (session == null) return;
            var url = $"/api/sessions/{session.SessionId}/heartbeat";
            var req = new { ExtendMinutes = 30 };
            var res = await Http.PostAsJsonAsync(url, req);
            // ignore result; logging for diagnostics
            if (!res.IsSuccessStatusCode)
            {
                Console.WriteLine($"NextSongView: Heartbeat failed with {(int)res.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"NextSongView: Heartbeat error: {ex.Message}");
        }
    }

    private void StartHeartbeatTimer()
    {
        heartbeatTimer?.Dispose();
        // send heartbeat every 5 minutes while NextSongView is active
        heartbeatTimer = new Timer(async _ =>
        {
            await SendHeartbeatAsync();
        }, null, TimeSpan.FromMinutes(5), TimeSpan.FromMinutes(5));
    }

    private void UpdateNextSong()
    {
        // Look for UpNext song (Status == 1)
        // Fallback to first Queued (Status == 0) during transition periods
        nextSong = PlaylistState.Value.Items
            .Where(i => i.Status == 1)
            .OrderBy(i => i.Position)
            .FirstOrDefault();
        
        if (nextSong == null)
        {
            // Fallback: check for Queued songs (shouldn't happen after backend auto-promotion)
            nextSong = PlaylistState.Value.Items
                .Where(i => i.Status == 0)
                .OrderBy(i => i.Position)
                .FirstOrDefault();
            
            if (nextSong != null)
            {
                Console.WriteLine($"NextSongView: WARNING - Found Queued song {nextSong.Id} instead of UpNext. Backend auto-promotion may not have run yet.");
            }
        }
        
        Console.WriteLine($"NextSongView: UpdateNextSong found {(nextSong != null ? $"song {nextSong.Id} ('{nextSong.Artist} - {nextSong.Title}') with status {nextSong.Status}" : "no song")}");
    }

    private Song? GetSongById(string? songId)
    {
        if (string.IsNullOrEmpty(songId)) return null;
        return LibraryState.Value.Songs.FirstOrDefault(s => s.Id.ToString() == songId);
    }

    private bool ItemsEqual(List<PlaylistItemDto> a, List<PlaylistItemDto> b)
    {
        if (a.Count != b.Count) return false;
        for (int i = 0; i < a.Count; i++)
        {
            if (a[i].Id != b[i].Id) return false;
        }
        return true;
    }

    private void StartAutoAdvanceTimer()
    {
        // Check if next song ID changed to prevent unnecessary timer resets
        var newNextSongId = nextSong?.Id;
        if (_currentNextSongId == newNextSongId && isTimerActive)
        {
            Console.WriteLine($"NextSongView: Timer already running for song {newNextSongId}, skipping restart");
            return;
        }
        
        _currentNextSongId = newNextSongId;
        
        // Cancel existing timers
        autoAdvanceTimer?.Dispose();
        countdownTimer?.Dispose();
        autoAdvanceTimer = null;
        countdownTimer = null;

        // Only start timer if we have a next song (Queued or UpNext) and pause is enabled
        if (nextSong != null && (nextSong.Status == 0 || nextSong.Status == 1) && 
            SessionState.Value.CurrentSession?.PauseBetweenSongs == true)
        {
            Console.WriteLine($"NextSongView: Starting timer for song {newNextSongId} (previous: {_currentNextSongId})");
            totalSeconds = SessionState.Value.CurrentSession.PauseBetweenSongsSeconds;
            remainingSeconds = totalSeconds;
            isTimerActive = true;
            countdownStart = DateTime.UtcNow;

            // Start countdown timer (updates every 100ms)
            countdownTimer = new Timer(_ =>
            {
                var elapsed = (DateTime.UtcNow - countdownStart).TotalSeconds;
                remainingSeconds = Math.Max(0, totalSeconds - elapsed);
                if (remainingSeconds <= 0)
                {
                    isTimerActive = false;
                    countdownTimer?.Dispose();
                    countdownTimer = null;
                }
                InvokeAsync(StateHasChanged);
            }, null, TimeSpan.Zero, TimeSpan.FromMilliseconds(100));

            // Start auto-advance timer
            autoAdvanceTimer = new Timer(async _ =>
            {
                if (!isDisposed)
                {
                    await InvokeAsync(async () => await NavigateToPlayer());
                }
            }, null, TimeSpan.FromSeconds(totalSeconds), Timeout.InfiniteTimeSpan);
        }
        else
        {
            isTimerActive = false;
        }
    }

    private async Task NavigateToPlayer()
    {
        if (SessionState.Value.CurrentSession != null)
        {
            var sessionId = SessionState.Value.CurrentSession.SessionId;

            // Advance to next song via SignalR (marks UpNext as NowPlaying)
            try
            {
                Console.WriteLine($"NextSongView: Dispatching AdvanceToNextSongAction for song {nextSong?.Id} and waiting for CurrentSong to be set...");
                
                // Create awaiter for playlist update
                _playlistUpdateAwaiter = new TaskCompletionSource<bool>();
                
                // Dispatch the action
                Dispatcher.Dispatch(new AdvanceToNextSongAction());
                
                // Wait for CurrentSong to be set (with timeout)
                var updateTask = _playlistUpdateAwaiter.Task;
                var timeoutTask = Task.Delay(5000);
                var completedTask = await Task.WhenAny(updateTask, timeoutTask);
                
                if (completedTask == updateTask)
                {
                    Console.WriteLine("NextSongView: CurrentSong set successfully, navigating to player");
                }
                else
                {
                    Console.WriteLine("NextSongView: WARNING - Timeout waiting for CurrentSong, navigating anyway");
                }
                
                _playlistUpdateAwaiter = null;
            }
            catch (Exception ex)
            {
                Console.WriteLine($"NextSongView: Error dispatching AdvanceToNextSongAction: {ex.Message}");
            }

            NavigationManager.NavigateTo($"/player?session={sessionId}");
        }
    }

    private string GenerateSessionUrl()
    {
        if (SessionState.Value.CurrentSession == null)
        {
            return string.Empty;
        }

        var sessionId = SessionState.Value.CurrentSession.SessionId;
        var baseUrl = NavigationManager.BaseUri.TrimEnd('/');
        
        // Include link token in URL so secondary tabs can authenticate
        // CRITICAL: URL-encode the token because it contains characters like '+' that need escaping
        if (!string.IsNullOrEmpty(TokenParam))
        {
            var encodedToken = Uri.EscapeDataString(TokenParam);
            return $"{baseUrl}/singer?session={sessionId}&token={encodedToken}";
        }
        
        return $"{baseUrl}/singer?session={sessionId}";
    }

    private void ToggleAdminMenu()
    {
        _showAdminMenu = !_showAdminMenu;
    }

    private async Task OpenPlaylistManager()
    {
        var url = $"/playlist?session={SessionParam}&token={TokenParam}";
        try
        {
            await JSRuntime.InvokeAsync<bool>("open", url, "_blank");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error opening Playlist Manager: {ex.Message}");
        }
        _showAdminMenu = false;
    }

    private async Task OpenSingerView()
    {
        var url = $"/singer?session={SessionParam}&token={TokenParam}";
        try
        {
            await JSRuntime.InvokeAsync<bool>("open", url, "_blank");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error opening Singer View: {ex.Message}");
        }
        _showAdminMenu = false;
    }

    protected override async ValueTask DisposeAsyncCore(bool disposing)
    {
        if (disposing)
        {
            isDisposed = true;

            // Dispose timer
            autoAdvanceTimer?.Dispose();
            countdownTimer?.Dispose();
            autoAdvanceTimer = null;
            countdownTimer = null;

            // Unsubscribe from playlist state changes
            try
            {
                PlaylistState.StateChanged -= OnPlaylistStateChanged;
            }
            catch { }

            // Dispose JS modules
            if (qrcodeModule != null)
            {
                await qrcodeModule.DisposeAsync();
            }

            if (_protectionModule != null)
            {
                try
                {
                    await _protectionModule.InvokeVoidAsync("removeMainTabProtection");
                    await _protectionModule.DisposeAsync();
                }
                catch
                {
                    // Ignore disposal errors
                }
            }
        }

        // Call base to dispose Fluxor subscriptions
        await base.DisposeAsyncCore(disposing);
    }
}
