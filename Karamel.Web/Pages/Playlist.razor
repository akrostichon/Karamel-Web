@page "/playlist"
@using Fluxor
@using Fluxor.Blazor.Web.Components
@using Karamel.Web.Models
@using Karamel.Web.Contracts
@using Karamel.Web.Store.Playlist
@using Karamel.Web.Store.Session
@using Karamel.Web.Store.Library
@using Karamel.Web.Services
@inherits FluxorComponent
@inject IState<PlaylistState> PlaylistState
@inject IState<SessionState> SessionState
@inject IDispatcher Dispatcher
@inject IJSRuntime JSRuntime
@inject Karamel.Web.Services.ISignalRConnectionManager ConnectionManager
@inject Karamel.Web.Services.IPlaylistStateSynchronizer StateSynchronizer

<PageTitle>Playlist - Karamel</PageTitle>

    <div class="playlist-container">
    @if (isInitializing)
    {
        <div class="text-center m-4">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Loading session...</span>
            </div>
            <p class="mt-2">Loading session...</p>
        </div>
    }
    else if (!isSessionValid)
    {
        <div class="alert alert-danger m-4" role="alert">
            <h4 class="alert-heading">Session Loading Failed</h4>
            <p>Unable to load the karaoke session. This may be due to:</p>
            <ul>
                <li>The session has expired (sessions last 30 minutes without activity)</li>
                <li>Network connectivity issues</li>
                <li>The QR code link is invalid or corrupted</li>
            </ul>
            <p>Please try scanning the QR code again, or start a new session from the home page.</p>
            <a href="/" class="btn btn-primary">Return to Home</a>
        </div>
    }
    else
    {
        <h1 class="mb-4">Playlist</h1>

    <!-- Segmented control: visible only for admin tabs -->
    @if (_isAdminTab)
    {
        <div class="playlist-segment-control mb-3" role="tablist">
            <button class="btn segment-btn @(_activeSegment == "playlist" ? "active" : "")"
                    role="tab"
                    aria-selected="@(_activeSegment == "playlist")"
                    @onclick='() => _activeSegment = "playlist"'>
                🎵 Playlist
            </button>
            <button class="btn segment-btn segment-btn-session @(_activeSegment == "session-controls" ? "active" : "")"
                    role="tab"
                    aria-selected="@(_activeSegment == "session-controls")"
                    @onclick='() => _activeSegment = "session-controls"'>
                ⚙️ Session Controls
            </button>
        </div>
    }

    <!-- Session Controls panel (admin, session-controls segment) -->
    @if (_isAdminTab && _activeSegment == "session-controls")
    {
        <SessionControls IsAdminTab="true" ConfigEnabled="true" OnNavigateBack="NavigateBackToPlaylist" />
    }

    <!-- Playlist content (always visible for non-admin; visible for admin when playlist segment active) -->
    @if (!_isAdminTab || _activeSegment == "playlist")
    {

    <!-- Now Playing Section -->
    @if (PlaylistState.Value.CurrentSong != null)
    {
        <div class="now-playing card mb-4">
            <div class="card-body">
                <h2 class="card-title">
                    <i class="bi bi-play-circle-fill text-on-surface me-2"></i>
                    Now Playing
                </h2>
                @{
                    var nowPlaying = PlaylistState.Value.CurrentSong;
                }
                <div class="song-info">
                    <div class="artist h4">@nowPlaying.Artist</div>
                    <div class="title h3 fw-bold">@nowPlaying.Title</div>
                    @if (!string.IsNullOrEmpty(nowPlaying.SingerName))
                    {
                        <div class="singer muted-on-surface">
                            <i class="bi bi-person-fill"></i> @nowPlaying.SingerName
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <!-- Up Next Section -->
    @if (!PlaylistState.Value.Items.Any())
    {
        <div class="alert alert-info" role="alert">
            <i class="bi bi-music-note-list"></i>
            No songs in queue. Add songs from the Singer view!
        </div>
    }
    else if (PlaylistState.Value.Items.Any(i => i.Status == (int)SongStatus.Queued || i.Status == (int)SongStatus.UpNext))
        {
            var upNextSongs = PlaylistState.Value.Items.Where(i => i.Status == (int)SongStatus.Queued || i.Status == (int)SongStatus.UpNext).OrderBy(i => i.Position).ToList();

            <div class="up-next card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h3 class="card-title mb-0">
                            <i class="bi bi-list-ol me-2"></i>
                            Up Next (@upNextSongs.Count)
                        </h3>
                        <button class="btn btn-destructive btn-sm btn-clear-playlist" @onclick="ClearPlaylist">
                            <i class="bi bi-trash-fill"></i> Clear All
                        </button>
                    </div>

                    <div class="song-list">
                        @{
                            var isDraggable = _isAdminTab || (SessionState.Value.CurrentSession?.AllowSingersToReorder ?? false);
                        }
                        @for (int i = 0; i < upNextSongs.Count; i++)
                        {
                            var song = upNextSongs[i];
                            var position = i + 2; // +2 because position 1 is "Now Playing"
                            var index = i;

                            @* Drop zone before this item *@
                            <div class="drop-zone @(dropTargetIndex == index ? "drop-zone-active" : "")"
                                 @ondragover="@(e => HandleDragOver(e, index))"
                                 @ondragover:preventDefault="true"
                                 @ondrop="@(() => HandleDrop(index))"
                                 @ondragleave="HandleDragLeave">
                            </div>

                            <div class="song-item @(isDraggable ? "draggable" : "") @(draggedIndex == index ? "dragging" : "")" 
                                 draggable="@isDraggable.ToString().ToLower()"
                                 @ondragstart="@((args) => HandleDragStart(args, index))">
                                <div class="song-position">
                                    #@position
                                </div>
                                <div class="song-details flex-grow-1">
                                    <div class="song-artist-title">
                                        <strong>@song.Artist</strong> - @song.Title
                                    </div>
                                    @if (!string.IsNullOrEmpty(song.SingerName))
                                    {
                                        <div class="song-singer muted-on-surface small">
                                            <i class="bi bi-person-fill"></i> @song.SingerName
                                        </div>
                                    }
                                </div>
                                <button class="btn btn-sm btn-destructive-outline btn-remove" 
                                        @onclick="@(() => RemoveSong(song.Id))">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            </div>
                        }
                        @* Drop zone after the last item *@
                        <div class="drop-zone @(dropTargetIndex == upNextSongs.Count ? "drop-zone-active" : "")"
                             @ondragover="@(e => HandleDragOver(e, upNextSongs.Count))"
                             @ondragover:preventDefault="true"
                             @ondrop="@(() => HandleDrop(upNextSongs.Count))"
                             @ondragleave="HandleDragLeave">
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    }
</div>

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "session")]
    public string? SessionParam { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "token")]
    public string? TokenParam { get; set; }

    private int? draggedIndex;
    private int? dropTargetIndex;
    private bool isSessionValid = false;
    private bool isInitializing = true;
    private bool _isAdminTab = false; // NEW: Track if current tab has admin privileges
    private string _activeSegment = "playlist"; // "playlist" or "session-controls"
    private IJSObjectReference? themeToggleModule;
    

    protected override void OnInitialized()
    {
        base.OnInitialized();

        // Subscribe to playlist state changes for debugging and to trigger re-render
        PlaylistState.StateChanged += OnPlaylistStateChanged;
        // Subscribe to session state changes so we can re-evaluate session validity
        SessionState.StateChanged += OnSessionStateChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        // Check if this tab has admin privileges (role=admin in sessionStorage)
        if (!string.IsNullOrWhiteSpace(SessionParam))
        {
            try
            {
                var role = await JSRuntime.InvokeAsync<string?>("sessionStorage.getItem", $"karamel-session-{SessionParam}-role");
                _isAdminTab = role == "admin";
                Console.WriteLine($"Playlist.razor: Tab role = {role}, isAdminTab = {_isAdminTab}");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Playlist.razor: Failed to check admin role: {ex.Message}");
                _isAdminTab = false;
            }
        }
    }

    private void OnSessionStateChanged(object? sender, EventArgs e)
    {
        // Recompute validity when SessionState changes and re-render
        isSessionValid = ValidateSession();
        // Apply theme in case config was updated remotely via ReceiveConfigUpdated
        _ = InvokeAsync(async () =>
        {
            await ApplySessionThemeAsync();
            StateHasChanged();
        });
    }

    private void OnPlaylistStateChanged(object? sender, EventArgs e)
    {
        try
        {
            var state = PlaylistState.Value;
            Console.WriteLine($"Playlist.razor: Playlist state changed. ItemsCount={state.Items?.Count ?? 0}");
        }
        catch { }

        InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        
        if (firstRender)
        {
            Console.WriteLine($"[Playlist] Initializing with SessionParam={SessionParam}, TokenParam={TokenParam?.Substring(0, Math.Min(20, TokenParam?.Length ?? 0))}...");
        }
        
        if (firstRender && !string.IsNullOrWhiteSpace(SessionParam) && Guid.TryParse(SessionParam, out var sessionGuid))
        {
            Console.WriteLine($"Playlist: Initializing session for GUID: {sessionGuid}");
            Console.WriteLine($"Playlist: TokenParam from URL: '{TokenParam}'");
            
            // Initialize session as secondary tab and load state from sessionStorage
            isInitializing = true;
            await ConnectionManager.InitializeAsync(sessionGuid, false, TokenParam);
            
            // Restore session state from backend/sessionStorage
            var (session, playlist, currentSong) = await StateSynchronizer.RestoreSessionStateAsync(sessionGuid);

            // Register listener for ongoing SignalR/BroadcastChannel state updates
            await StateSynchronizer.SetupStateUpdateListenerAsync();
            
            if (session != null)
            {
                Dispatcher.Dispatch(new Karamel.Web.Store.Session.InitializeSessionAction(session));
            }
            if (playlist != null && playlist.Any())
            {
                var currentSongItem = currentSong != null
                    ? new PlaylistItemDto(
                        Id: Guid.NewGuid().ToString(),
                        SongId: currentSong.Id,
                        Artist: currentSong.Artist,
                        Title: currentSong.Title,
                        SingerName: currentSong.AddedBySinger,
                        Position: 0,
                        Status: (int)SongStatus.NowPlaying
                    )
                    : null;
                Dispatcher.Dispatch(new Karamel.Web.Store.Playlist.UpdatePlaylistFromBroadcastAction(playlist, currentSongItem));
            }
            
            Console.WriteLine($"[Playlist] State restoration completed");

            isSessionValid = ValidateSession();
            
            // Apply session theme if set
            await ApplySessionThemeAsync();
            
            isInitializing = false;
            
            // If this is the main tab, add beforeunload warning
            if (ConnectionManager.IsMainTab)
            {
                await JSRuntime.InvokeVoidAsync("eval", @"
                    window.addEventListener('beforeunload', function(e) {
                        e.preventDefault();
                        e.returnValue = 'Closing this tab will end the karaoke session for all connected devices. Are you sure?';
                        return e.returnValue;
                    });
                ");
            }
            
            StateHasChanged();
        }
    }

    private async Task ApplySessionThemeAsync()
    {
        try
        {
            var theme = SessionState.Value.CurrentSession?.Theme;
            if (!string.IsNullOrWhiteSpace(theme))
            {
                Console.WriteLine($"[Playlist] Applying session theme: {theme}");
                themeToggleModule ??= await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/themeToggle.js");
                await themeToggleModule.InvokeVoidAsync("setTheme", theme);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Playlist] Failed to apply theme: {ex.Message}");
        }
    }

    private bool ValidateSession()
    {
        // If no session in state, it's invalid
        if (SessionState.Value.CurrentSession == null)
        {
            Console.WriteLine($"[Playlist] Session validation failed: CurrentSession is null");
            return false;
        }

        // STRICT VALIDATION: Session parameter is REQUIRED for multi-session support
        if (string.IsNullOrWhiteSpace(SessionParam) || !Guid.TryParse(SessionParam, out var sessionGuid))
        {
            Console.WriteLine($"[Playlist] Session validation failed: Invalid SessionParam '{SessionParam}'");
            return false;
        }

        // Session ID must match the parameter
        var match = SessionState.Value.CurrentSession.SessionId == sessionGuid;
        if (!match)
        {
            Console.WriteLine($"[Playlist] Session validation failed: State.SessionId={SessionState.Value.CurrentSession.SessionId}, URL.SessionId={sessionGuid}");
        }
        
        return match;
    }

    private void RemoveSong(string itemId)
    {
        if (Guid.TryParse(itemId, out var guid))
        {
            Dispatcher.Dispatch(new RemoveSongAction(guid));
        }
    }

    private void NavigateBackToPlaylist()
    {
        _activeSegment = "playlist";
    }

    private async Task ClearPlaylist()
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", 
            "Are you sure you want to clear all queued songs? The currently playing song will not be affected.");
        
        if (confirmed)
        {
            Dispatcher.Dispatch(new ClearPlaylistAction());
        }
    }

    private void HandleDragStart(DragEventArgs e, int index)
    {
        e.DataTransfer.EffectAllowed = "move";
        // Firefox requires data to be set for drag to work
        e.DataTransfer.Items = new[] { new DataTransferItem { Kind = "text", Type = "text/plain" } };
        draggedIndex = index;

        // Log the dragged item
        var upNextSongs = PlaylistState.Value.Items
            .Where(i => i.Status == (int)SongStatus.Queued || i.Status == (int)SongStatus.UpNext)
            .OrderBy(i => i.Position)
            .ToList();
        
        if (index >= 0 && index < upNextSongs.Count)
        {
            var draggedSong = upNextSongs[index];
            Console.WriteLine($"[Drag & Drop] Started dragging: Index={index}, Song='{draggedSong.Artist} - {draggedSong.Title}' {(string.IsNullOrEmpty(draggedSong.SingerName) ? "" : $"(Singer: {draggedSong.SingerName})")}");
        }
    }

    private void HandleDragOver(DragEventArgs e, int dropIndex)
    {
        e.DataTransfer.DropEffect = "move";
        
        // Show drop indicator at the target insertion point
        if (draggedIndex.HasValue && draggedIndex.Value != dropIndex)
        {
            dropTargetIndex = dropIndex;
            
            // Log the hover over drop target
            Console.WriteLine($"[Drag & Drop] Hovering over drop position: {dropIndex}");
        }
    }

    private void HandleDrop(int dropIndex)
    {
        if (draggedIndex.HasValue)
        {
            int fromIndex = draggedIndex.Value;
            
            // dropIndex is "insert before this position"
            // If dropping after the dragged item, need to account for the item being removed first
            int toIndex = dropIndex > fromIndex ? dropIndex - 1 : dropIndex;
            
            // Only dispatch if the position actually changes
            if (fromIndex != toIndex)
            {
                // Get the current playlist order before reordering
                var upNextSongs = PlaylistState.Value.Items
                    .Where(i => i.Status == (int)SongStatus.Queued || i.Status == (int)SongStatus.UpNext)
                    .OrderBy(i => i.Position)
                    .ToList();

                // Log the order before
                Console.WriteLine("[Drag & Drop] === REORDER OPERATION ===");
                Console.WriteLine($"[Drag & Drop] Dragged from index: {fromIndex}, Dropped at index: {toIndex}");
                
                var draggedSong = upNextSongs[fromIndex];
                Console.WriteLine($"[Drag & Drop] Song moved: '{draggedSong.Artist} - {draggedSong.Title}'");
                
                Console.WriteLine("[Drag & Drop] Order BEFORE reorder:");
                for (int i = 0; i < upNextSongs.Count; i++)
                {
                    var song = upNextSongs[i];
                    var marker = i == fromIndex ? " <-- DRAGGED" : "";
                    Console.WriteLine($"  [{i}] {song.Artist} - {song.Title}{marker}");
                }

                // Dispatch reorder action with 0-based indices (backend handles active items only)
                Dispatcher.Dispatch(new ReorderPlaylistAction(fromIndex, toIndex));

                // Log the expected order after (we simulate it here)
                Console.WriteLine("[Drag & Drop] Order AFTER reorder (expected):");
                var simulatedOrder = upNextSongs.ToList();
                var item = simulatedOrder[fromIndex];
                simulatedOrder.RemoveAt(fromIndex);
                simulatedOrder.Insert(toIndex, item);
                
                for (int i = 0; i < simulatedOrder.Count; i++)
                {
                    var song = simulatedOrder[i];
                    var marker = song.Id == draggedSong.Id ? " <-- MOVED HERE" : "";
                    Console.WriteLine($"  [{i}] {song.Artist} - {song.Title}{marker}");
                }
                Console.WriteLine("[Drag & Drop] === END REORDER OPERATION ===");
            }
            else
            {
                Console.WriteLine("[Drag & Drop] Drop cancelled: Song dropped at the same position");
            }
        }
        
        draggedIndex = null;
        dropTargetIndex = null;
    }

    private void HandleDragLeave()
    {
        dropTargetIndex = null;
    }
}
